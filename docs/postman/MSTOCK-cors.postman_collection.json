{
  "info": {
    "name": "MSTOCK CORS (gateway)",
    "description": "Necesita encendidos: eureka, config-server, auth, ventas, catalogo e inventario y el api-gateway (puerto 8080). Postman permite poner la cabecera Origin a mano en la app de escritorio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Preflight (OPTIONS, sin token, como lo manda el navegador)",
      "item": [
        {
          "name": "C01 Origen permitido: 200 con los permisos, sin pedir token",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:4200"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/ventas",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 (no 401: el preflight no lleva token)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Allow-Origin es el de Angular\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:4200\"));",
                  "pm.test(\"Permite POST\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"POST\"));",
                  "pm.test(\"Permite Authorization\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Headers\").toLowerCase()).to.include(\"authorization\"));",
                  "pm.test(\"Cachea el preflight 1 hora\", () => pm.expect(pm.response.headers.get(\"Access-Control-Max-Age\")).to.eql(\"3600\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "C02 Preflight de PUT y DELETE tambien se permiten",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:4200"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "DELETE"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos/1",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "1"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Permite DELETE\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"DELETE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "C03 [Error] Origen no permitido -> 403",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://malo.example"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/ventas",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"No hay Allow-Origin\", () => pm.expect(pm.response.headers.has(\"Access-Control-Allow-Origin\")).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "C04 [Error] Cabecera no permitida -> 403",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
