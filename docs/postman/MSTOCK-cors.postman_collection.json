            }
          ]
        }
      ]
    },
    {
      "name": "2 Peticiones reales con Origin",
      "item": [
        {
          "name": "R01 Login desde Angular: la respuesta trae Allow-Origin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:4200"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Allow-Origin\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:4200\"));",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "R02 GET autenticado: Allow-Origin y expone Content-Disposition",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:4200"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/ventas",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Allow-Origin\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:4200\"));",
                  "pm.test(\"Expone Content-Disposition (descargas)\", () => pm.expect(pm.response.headers.get(\"Access-Control-Expose-Headers\")).to.include(\"Content-Disposition\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "R03 Un 401 tambien lleva Allow-Origin (si no, Angular no puede leer el error)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:4200"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/ventas",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Allow-Origin\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:4200\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "R04 [Error] Peticion desde un origen no permitido -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://malo.example"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/ventas",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "R05 Sin Origin (Postman, curl, servicios) sigue funcionando normal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/ventas",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Sin cabeceras CORS\", () => pm.expect(pm.response.headers.has(\"Access-Control-Allow-Origin\")).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
