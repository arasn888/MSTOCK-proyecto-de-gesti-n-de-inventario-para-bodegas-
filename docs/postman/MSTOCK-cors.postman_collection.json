                "value": "GET"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "x-secreto"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/ventas",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "C05 [Error] Metodo no permitido (PATCH) -> 403",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:4200"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "PATCH"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/ventas",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "ventas"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
