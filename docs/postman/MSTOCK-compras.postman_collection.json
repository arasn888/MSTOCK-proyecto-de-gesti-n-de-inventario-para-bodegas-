    {
      "name": "2 Compras y stock",
      "item": [
        {
          "name": "C01 Registrar compra de 10 + 5 unidades (almacenero) -> total 45.00",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Total 45.00 con costos del catalogo\", () => pm.expect(Number(pm.response.json().total)).to.eql(45));",
                  "pm.test(\"2 lineas\", () => pm.expect(pm.response.json().items.length).to.eql(2));",
                  "pm.collectionVariables.set(\"compraCp\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/compras",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "compras"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlmacenero}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proveedorId\": \"{{proveedorCp}}\",\n  \"items\": [\n    {\n      \"productoId\": \"{{productoCp1}}\",\n      \"cantidad\": 10\n    },\n    {\n      \"productoId\": \"{{productoCp2}}\",\n      \"cantidad\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "El body no lleva costos: los toma el catalogo. El stock se suma de forma asincrona por RabbitMQ."
          }
        },
        {
          "name": "C02 Esperar y verificar: el inventario sumó 10 del producto 1 (por RabbitMQ)",
