{
  "info": {
    "name": "MSTOCK Inventario",
    "description": "Pruebas del inventario-service (puerto 9003): entradas, salidas, ajustes, kardex, alertas y seguridad por rol. Requiere auth-service (9001) e inventario-service (9003). Ejecutar COMPLETA y en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenAdmin}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "inventarioUrl",
      "value": "http://localhost:9003"
    },
    {
      "key": "authUrl",
      "value": "http://localhost:9001"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenAlmacenero",
      "value": ""
    },
    {
      "key": "tokenCajero",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
