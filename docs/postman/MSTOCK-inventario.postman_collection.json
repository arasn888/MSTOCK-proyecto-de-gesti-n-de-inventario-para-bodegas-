    {
      "name": "1 Flujo de inventario",
      "item": [
        {
          "name": "I01 Entrada inicial de 20 unidades (almacenero)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{inventarioUrl}}/api/inventario/entradas",
              "host": [
                "{{inventarioUrl}}"
              ],
              "path": [
                "api",
                "inventario",
                "entradas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": {{productoId}},\n  \"cantidad\": 20,\n  \"motivo\": \"Compra inicial\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlmacenero}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"productoId\", String(1000000 + Number(String(Date.now()).slice(-7))));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const m = pm.response.json();",
                  "pm.test(\"Es una ENTRADA\", () => pm.expect(m.tipo).to.eql(\"ENTRADA\"));",
                  "pm.test(\"Stock anterior 0\", () => pm.expect(m.stockAnterior).to.eql(0));",
                  "pm.test(\"Stock resultante 20\", () => pm.expect(m.stockResultante).to.eql(20));",
                  "pm.test(\"Registra al usuario del token\", () => pm.expect(m.usuario).to.eql(\"almacenero_inv\"));",
                  "pm.test(\"Location apunta al kardex\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/movimientos\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "I02 Consultar el stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventarioUrl}}/api/inventario/{{productoId}}",
              "host": [
                "{{inventarioUrl}}"
              ],
              "path": [
                "api",
                "inventario",
                "{{productoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"Cantidad 20\", () => pm.expect(s.cantidad).to.eql(20));",
                  "pm.test(\"Stock minimo por defecto 5\", () => pm.expect(s.stockMinimo).to.eql(5));",
                  "pm.test(\"No esta bajo el minimo\", () => pm.expect(s.bajoMinimo).to.eql(false));"
                ]
              }
            }
          ]
        },
