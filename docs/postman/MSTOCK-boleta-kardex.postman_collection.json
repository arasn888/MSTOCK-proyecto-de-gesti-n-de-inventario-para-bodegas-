    {
      "name": "2 Boleta PDF",
      "item": [
        {
          "name": "B01 El cajero descarga la boleta -> 200 application/pdf",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ventasUrl}}/api/ventas/{{ventaId}}/boleta",
              "host": [
                "{{ventasUrl}}"
              ],
              "path": [
