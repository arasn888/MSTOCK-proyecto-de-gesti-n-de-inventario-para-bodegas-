{
  "info": {
    "name": "MSTOCK Boleta PDF y Kardex CSV",
    "description": "Necesita encendidos: eureka, config-server, auth, catalogo, inventario y ventas. Ejecuta las carpetas 0 a 3 en orden con el Runner. Para ver la boleta o el CSV de verdad, usa 'Send and Download' en B01, B05 y K01.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
