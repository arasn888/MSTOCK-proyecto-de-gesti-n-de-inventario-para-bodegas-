    {
      "name": "3 Kardex CSV",
      "item": [
        {
          "name": "K01 El almacenero exporta el kardex -> 200 text/csv",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{inventarioUrl}}/api/inventario/{{producto1}}/kardex/csv",
              "host": [
                "{{inventarioUrl}}"
              ],
              "path": [
                "api",
                "inventario",
                "{{producto1}}",
                "kardex",
                "csv"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlmacenero}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es CSV UTF-8\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/csv\"));",
                  "pm.test(\"Se descarga como adjunto\", () => pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.match(/attachment.*kardex-.+\\.csv/));",
                  "const csv = pm.response.text();",
                  "pm.test(\"Trae el codigo del producto\", () => pm.expect(csv).to.include(pm.collectionVariables.get(\"codigo1\")));",
                  "pm.test(\"Trae la cabecera de columnas\", () => pm.expect(csv).to.include(\"Fecha,Tipo,Cantidad,Stock anterior,Stock resultante,Motivo,Usuario\"));",
                  "pm.test(\"La coma del motivo va entre comillas y la formula se neutraliza\", () => pm.expect(csv).to.include(\"\\\"'=Stock inicial, lote 1\\\"\"));",
                  "pm.test(\"Entrada primero y venta despues (orden cronologico)\", () => pm.expect(csv.indexOf(\",ENTRADA,\")).to.be.below(csv.indexOf(\",SALIDA,\")));"
                ]
              }
            }
          ]
        },
