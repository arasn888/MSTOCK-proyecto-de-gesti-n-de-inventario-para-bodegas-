                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creado\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"producto1\", pm.response.json().id);",
                  "pm.collectionVariables.set(\"codigo1\", pm.response.json().codigo);"
                ]
              }
            }
          ]
        },
        {
          "name": "P02 Entrada de 20 unidades, motivo con coma y formula",
