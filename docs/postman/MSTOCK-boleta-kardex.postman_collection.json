                "ventas",
                "{{ventaId}}",
                "boleta"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCajero}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es un PDF\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"));",
                  "pm.test(\"Empieza con %PDF\", () => pm.expect(pm.response.text().startsWith(\"%PDF\")).to.be.true);",
                  "pm.test(\"Nombre de archivo boleta-<numero>.pdf\", () => pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.match(/filename=\"?boleta-.+\\.pdf/));"
                ]
              }
            }
          ]
        },
