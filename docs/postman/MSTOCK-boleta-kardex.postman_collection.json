              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"BOL-{{$timestamp}}\",\n  \"nombre\": \"Producto boleta\",\n  \"descripcion\": \"Postman boleta y kardex\",\n  \"precioCompra\": 2.0,\n  \"precioVenta\": 5.0,\n  \"unidadMedida\": \"UNIDAD\",\n  \"categoriaId\": 1,\n  \"activo\": true\n}",
              "options": {
