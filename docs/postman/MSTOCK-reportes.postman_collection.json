    {
      "name": "3 Cierre de caja",
      "item": [
        {
          "name": "C01 Admin ve todos los cajeros, incluido cajero_rep con su anulada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ventasUrl}}/api/reportes/cierre-caja",
              "host": [
                "{{ventasUrl}}"
              ],
              "path": [
                "api",
                "reportes",
