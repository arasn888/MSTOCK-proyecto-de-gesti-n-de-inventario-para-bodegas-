                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const c = r.cajeros.find(x => x.usuario === \"cajero_rep\");",
                  "pm.test(\"cajero_rep tiene ventas y una anulada de 10.00\", () => { pm.expect(c.cantidadVentas).to.be.at.least(1); pm.expect(c.cantidadAnuladas).to.be.at.least(1); pm.expect(c.totalAnulado).to.be.at.least(10); });",
                  "pm.test(\"Los totales suman a los cajeros\", () => pm.expect(+r.cajeros.reduce((a, x) => a + x.totalVendido, 0).toFixed(2)).to.eql(r.totales.totalVendido));"
                ]
              }
            }
          ]
        },
