    {
      "name": "2 Dashboard",
      "item": [
        {
          "name": "D01 Admin: la venta A suma (+1 venta, +15.00, +9.00 de ganancia); la B anulada no",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ventasUrl}}/api/reportes/dashboard?top=50",
              "host": [
                "{{ventasUrl}}"
              ],
              "path": [
                "api",
                "reportes",
                "dashboard?top=50"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"+1 venta\", () => pm.expect(r.ventas.cantidad - Number(pm.collectionVariables.get(\"baseCantidad\"))).to.eql(1));",
                  "pm.test(\"+15.00 vendido\", () => pm.expect(+(r.ventas.total - Number(pm.collectionVariables.get(\"baseTotal\"))).toFixed(2)).to.eql(15));",
                  "pm.test(\"+9.00 de ganancia\", () => pm.expect(+(r.ventas.ganancia - Number(pm.collectionVariables.get(\"baseGanancia\"))).toFixed(2)).to.eql(9));",
                  "pm.test(\"Hay al menos una anulada\", () => pm.expect(r.anuladas.cantidad).to.be.at.least(1));",
                  "const p = r.masVendidos.find(x => x.productoId == pm.collectionVariables.get(\"producto1\"));",
                  "pm.test(\"El producto aparece con 3 unidades (la anulada no cuenta)\", () => pm.expect(p.unidadesVendidas).to.eql(3));"
                ]
              }
            }
          ]
        },
