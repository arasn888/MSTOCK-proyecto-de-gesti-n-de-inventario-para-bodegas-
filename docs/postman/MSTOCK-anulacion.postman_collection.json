              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creada\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Estado COMPLETADA\", () => pm.expect(pm.response.json().estado).to.eql(\"COMPLETADA\"));",
                  "pm.collectionVariables.set(\"ventaId\", pm.response.json().id);"
                ]
              }
            }
