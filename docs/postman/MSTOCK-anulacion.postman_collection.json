{
  "info": {
    "name": "MSTOCK Anulacion e idempotencia",
    "description": "Necesita encendidos: eureka, config-server, auth, catalogo, inventario y ventas (y RabbitMQ para los eventos). Ejecuta las carpetas 0 a 3 en orden con el Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 Autenticacion",
      "item": [
        {
          "name": "A01 Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "A02 Crear cajero de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/api/usuarios",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cajero_anul\",\n  \"password\": \"Cajero123*\",\n  \"nombres\": \"Prueba\",\n  \"apellidos\": \"Anulacion\",\n  \"email\": \"cajero_anul@mstock.com\",\n  \"rol\": \"CAJERO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creado (201) o ya existente (409)\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "A03 Login cajero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
