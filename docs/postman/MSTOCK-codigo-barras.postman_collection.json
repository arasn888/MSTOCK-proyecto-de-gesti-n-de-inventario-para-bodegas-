{
  "info": {
    "name": "MSTOCK Codigo de barras (por el gateway 8080)",
    "description": "Necesita catalogo-service y api-gateway. Ejecuta todo en el Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenAlmacenero",
      "value": ""
    },
    {
      "key": "tokenCajero",
      "value": ""
    },
    {
      "key": "codigoBarras",
      "value": ""
    },
    {
      "key": "productoBarras",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Login por el gateway",
      "item": [
        {
          "name": "L01 Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "L02 Crear almacenero de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/usuarios",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"almacenero_gw\",\n  \"password\": \"Cajero123*\",\n  \"nombres\": \"Prueba\",\n  \"apellidos\": \"Gateway\",\n  \"email\": \"almacenero_gw@mstock.com\",\n  \"rol\": \"ALMACENERO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creado (201) o ya existente (409)\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "L03 Crear cajero de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/usuarios",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cajero_gw\",\n  \"password\": \"Cajero123*\",\n  \"nombres\": \"Prueba\",\n  \"apellidos\": \"Gateway\",\n  \"email\": \"cajero_gw@mstock.com\",\n  \"rol\": \"CAJERO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creado (201) o ya existente (409)\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "L04 Login almacenero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"almacenero_gw\",\n  \"password\": \"Cajero123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenAlmacenero\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "L05 Login cajero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cajero_gw\",\n  \"password\": \"Cajero123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenCajero\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "L06 Login con clave incorrecta -> 401 (lo responde auth)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Busqueda por codigo",
      "item": [
        {
          "name": "B01 Crear producto con un codigo de barras EAN-13 (admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"codigoBarras\", \"775\" + String(Math.floor(1000000000 + Math.random()*8999999999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"productoBarras\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigoBarras}}\",\n  \"nombre\": \"Gaseosa de prueba {{codigoBarras}}\",\n  \"descripcion\": \"Postman codigo de barras\",\n  \"precioCompra\": 2.0,\n  \"precioVenta\": 3.5,\n  \"unidadMedida\": \"UNIDAD\",\n  \"categoriaId\": 1,\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "B02 Lector de codigo: el cajero busca por codigo exacto -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es el producto creado\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"productoBarras\")));",
                  "pm.test(\"Trae el precio de venta\", () => pm.expect(Number(pm.response.json().precioVenta)).to.eql(3.5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos/codigo/{{codigoBarras}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "codigo",
                "{{codigoBarras}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCajero}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "B03 [Error] Codigo que no existe -> 404 con mensaje claro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Mensaje del codigo\", () => pm.expect(pm.response.json().mensaje).to.include(\"No existe un producto activo con el código\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos/codigo/0000000000000",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "codigo",
                "0000000000000"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCajero}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "B04 Busqueda por parte del codigo (7 primeros digitos) -> incluye el producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Lo encuentra por codigo\", () => pm.expect(pm.response.json().some(p => p.id == pm.collectionVariables.get(\"productoBarras\"))).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos?nombre={{codigoBarras}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ],
              "query": [
                {
                  "key": "nombre",
                  "value": "{{codigoBarras}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCajero}}",
                  "type": "string"
                }
              ]
            },
            "description": "Antes el filtro nombre solo miraba el nombre; ahora tambien el codigo."
          }
        },
        {
          "name": "B05 Busqueda por nombre sigue funcionando",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos?nombre=Gaseosa de prueba",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ],
              "query": [
                {
                  "key": "nombre",
                  "value": "Gaseosa de prueba"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCajero}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "B06 [Error] Sin token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos/codigo/{{codigoBarras}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "codigo",
                "{{codigoBarras}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "B07 Desactivar el producto (admin) -> 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos/{{productoBarras}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{productoBarras}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "B08 [Error] Un producto desactivado ya no se encuentra por codigo -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos/codigo/{{codigoBarras}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "codigo",
                "{{codigoBarras}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCajero}}",
                  "type": "string"
                }
              ]
            },
            "description": "El punto de venta no debe poder vender un producto dado de baja."
          }
        }
      ]
    }
  ]
}