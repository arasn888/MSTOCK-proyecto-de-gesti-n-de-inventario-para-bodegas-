    {
      "name": "1 Publicar eventos en RabbitMQ",
      "item": [
        {
          "name": "E01 Publicar evento stock.bajo (API de RabbitMQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{rabbitUrl}}/api/exchanges/%2F/mstock.eventos/publish",
              "host": [
                "{{rabbitUrl}}"
              ],
              "path": [
                "api",
                "exchanges",
                "%2F",
                "mstock.eventos",
                "publish"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"content_type\": \"application/json\"\n  },\n  \"routing_key\": \"stock.bajo\",\n  \"payload\": \"{\\\"productoId\\\": {{productoId}}, \\\"productoNombre\\\": \\\"Gaseosa Test {{productoId}}\\\", \\\"cantidad\\\": 3, \\\"stockMinimo\\\": 5}\",\n  \"payload_encoding\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = 2000000 + Number(String(Date.now()).slice(-7));",
                  "pm.collectionVariables.set(\"productoId\", String(n));",
                  "pm.collectionVariables.set(\"ventaId\", String(n + 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"RabbitMQ enruto el mensaje a una cola\", () => pm.expect(pm.response.json().routed).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "E02 Publicar evento venta.registrada",
