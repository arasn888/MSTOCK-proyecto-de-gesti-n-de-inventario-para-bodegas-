            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{rabbitUrl}}/api/exchanges/%2F/mstock.eventos/publish",
              "host": [
                "{{rabbitUrl}}"
              ],
              "path": [
                "api",
                "exchanges",
                "%2F",
                "mstock.eventos",
                "publish"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"content_type\": \"application/json\"\n  },\n  \"routing_key\": \"stock.bajo\",\n  \"payload\": \"{ esto no es json\",\n  \"payload_encoding\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
