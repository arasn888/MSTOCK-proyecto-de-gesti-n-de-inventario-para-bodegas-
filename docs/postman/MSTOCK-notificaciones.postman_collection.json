{
  "info": {
    "name": "MSTOCK Notificaciones",
    "description": "Pruebas del notificaciones-service (puerto 9006) y de los eventos de RabbitMQ. Requiere RabbitMQ (Docker), auth-service (9001) y notificaciones-service (9006). Antes de ejecutar: escribir rabbitUser y rabbitPassword en las variables de la coleccion (Current value). Ejecutar COMPLETA y en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenAdmin}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "notificacionesUrl",
      "value": "http://localhost:9006"
    },
    {
      "key": "authUrl",
      "value": "http://localhost:9001"
    },
    {
      "key": "rabbitUrl",
      "value": "http://localhost:15673"
    },
    {
      "key": "rabbitUser",
      "value": ""
    },
    {
      "key": "rabbitPassword",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenCajero",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "ventaId",
      "value": ""
    },
    {
      "key": "notificacionId",
      "value": ""
