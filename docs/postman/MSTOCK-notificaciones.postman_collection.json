    {
      "name": "2 Consultar y gestionar notificaciones",
      "item": [
        {
          "name": "N01 Listar no leidas: llegaron las dos alertas, sin duplicar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{notificacionesUrl}}/api/notificaciones?soloNoLeidas=true",
              "host": [
                "{{notificacionesUrl}}"
              ],
              "path": [
                "api",
                "notificaciones"
              ],
              "query": [
                {
                  "key": "soloNoLeidas",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 2500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "const pid = Number(pm.collectionVariables.get(\"productoId\"));",
                  "const vid = Number(pm.collectionVariables.get(\"ventaId\"));",
                  "const alertas = lista.filter(n => n.tipo === \"STOCK_BAJO\" && n.referenciaId === pid);",
                  "const ventas = lista.filter(n => n.tipo === \"VENTA_REGISTRADA\" && n.referenciaId === vid);",
                  "pm.test(\"Una sola alerta de stock bajo (el segundo evento no duplica)\", () => pm.expect(alertas.length).to.eql(1));",
                  "pm.test(\"Una notificacion de venta\", () => pm.expect(ventas.length).to.eql(1));",
                  "pm.test(\"Mensaje de stock bajo con las cantidades del primer evento\", () => pm.expect(alertas[0].mensaje).to.include(\"3 unidad(es)\"));",
                  "pm.test(\"Mensaje de venta con el total a dos decimales\", () => pm.expect(ventas[0].mensaje).to.include(\"S/ 25.50\"));",
                  "pm.test(\"Nacen sin leer\", () => pm.expect(alertas[0].leida).to.eql(false));",
                  "if (alertas.length) { pm.collectionVariables.set(\"notificacionId\", alertas[0].id); }"
                ]
              }
            }
          ]
        },
