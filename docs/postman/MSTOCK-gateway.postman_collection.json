  "item": [
    {
      "name": "0 Sin token (el gateway rechaza)",
      "item": [
        {
          "name": "G01 GET productos sin token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/productos",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mensaje: Se requiere autenticación\", () => pm.expect(pm.response.json().mensaje).to.include(\"Se requiere autenticación\"));"
                ]
              }
            }
          ]
        },
